# Copia este archivo como ".env" y reemplaza los valores con los tuyos.
# El archivo ".env" real NUNCA se sube a Git (ver .gitignore).

# ── Base de datos MySQL ──
# Cada persona debe tener su propia instancia local de MySQL corriendo,
# con una base de datos vacía creada así:
#   CREATE DATABASE restoiq CHARACTER SET utf8mb4;
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_local
DB_NAME=restoiq

# ── Flask ──
SECRET_KEY=cambia-esto-por-cualquier-cadena-larga-aleatoria
FLASK_ENV=development
FLASK_DEBUG=1
